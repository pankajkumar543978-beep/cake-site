# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
/.next/
/out/
/build

# Testing & Playwright artifacts
/coverage
/playwright-report/
/test-results/
/.playwright-mcp/

# Environment Variables & Secrets (NEVER COMMIT SECRETS)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Operating System & Editor Junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.pem
*.key
*.cert
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Debug, Runtime & npm Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Vercel deployment cache
.vercel

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# Temporary scripts & scratch files
scrape-*.mjs
download-*.mjs
verify-*.mjs
test-*.mjs
gmaps-*.json
gmaps-*.txt
*.png
!public/**
!src/**
